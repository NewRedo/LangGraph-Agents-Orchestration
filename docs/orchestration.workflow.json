    {
      "id": "terms_worker",
      "lane": "workers",
      "col": 3,
      "type": "backend",
      "label": "Terminology worker",
      "sublabel": "Explain matched concepts",
      "width": 176
    },
    {
      "id": "patient_tool",
      "lane": "evidence",
      "col": 1,
      "type": "database",
      "label": "get_patient",
      "sublabel": "patients.json",
      "tag": "MCP over stdio"
    },
    {
      "id": "terms_tool",
      "lane": "evidence",
      "col": 3,
      "type": "database",
      "label": "search_umls",
      "sublabel": "umls.json",
      "tag": "MCP over stdio"
    }
  ],
  "edges": [
    {
      "from": "ask",
      "to": "supervisor",
      "label": "Initialize state"
    },
    {
      "from": "supervisor",
      "to": "patient_worker",
      "label": "Assign",
      "role": "branch",
      "toSide": "top"
    },
    {
      "from": "patient_worker",
      "to": "supervisor",
      "label": "Patient evidence",
      "role": "return"
    },
    {
      "from": "supervisor",
      "to": "terms_worker",
      "label": "Assign",
      "role": "branch"
    },
    {
      "from": "terms_worker",
      "to": "supervisor",
      "label": "Concept evidence",
      "role": "return"
    },
    {
      "from": "patient_worker",
      "to": "patient_tool",
      "label": "Read profile"
    },
    {
      "from": "terms_worker",
      "to": "terms_tool",
      "label": "Search terms"
    },
    {
      "from": "supervisor",
      "to": "critic",
      "label": "Draft after both workers"
    },
    {
      "from": "critic",
      "to": "supervisor",
      "label": "One revision",
      "role": "return",
      "variant": "dashed"
    },
    {
      "from": "critic",
      "to": "response",
      "label": "Pass or limit"
    }
