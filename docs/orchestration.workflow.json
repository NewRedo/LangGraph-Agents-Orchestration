  "cards": [
    {
      "dot": "cyan",
      "title": "Four roles, two models",
      "items": [
        "Supervisor chooses which worker runs first. Each runs once.",
        "Both workers and the supervisor use MAIN_MODEL."
      ]
    },
    {
      "dot": "rose",
      "title": "Bounded review",
      "items": [
        "Critic uses CRITIC_MODEL. A rejection returns feedback.",
        "Two rejected drafts end as needs_review. No answer released."
      ]
    },
    {
      "dot": "emerald",
      "title": "Teaching data",
      "items": [
        "JSON mimics patient records and terminology lookup.",
        "Fictional records. Educational output, no diagnosis."
      ]
    }
  ]
