{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Medical AI. Two workers, one review loop",
    "locale": "en",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "orchestration",
      "label": "FastAPI and LangGraph"
    },
    {
      "id": "workers",
      "label": "Specialist workers. Shared model"
    },
    {
      "id": "evidence",
      "label": "Read only MCP tools. Synthetic JSON"
    }
  ],
  "mainPath": [
    "ask",
    "supervisor",
    "critic",
    "response"
  ],
  "nodes": [
    {
      "id": "ask",
